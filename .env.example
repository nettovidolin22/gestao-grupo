# Copie este arquivo para .env e preencha.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# DEBUG=1 só no seu computador. Em produção, apague esta linha ou use DEBUG=0.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Sem DATABASE_URL o sistema usa um SQLite local (db.sqlite3).
# Supabase: Project Settings > Database > Connection string (URI).
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Endereço público do sistema (usado nos links dos e-mails)
# SITE_URL=https://gestao.suaempresa.com.br
# E-mail (sem EMAIL_HOST os e-mails só aparecem no terminal)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Gestão do Grupo <nao-responda@suaempresa.com.br>

# Domínios de e-mail aceitos no cadastro de usuários (separe por vírgula)
# DOMINIOS_EMAIL=gencau.com.br,balaio.com.br,titan.com.br
